# Reproduction-script paths. Copy this file to `paths.env` and edit, or
# export the same variables in your shell before running the scripts.
# `paths.env` is gitignored so your local paths never reach the public repo.
#
#   cp paths.env.example paths.env
#   # edit paths.env to point at your local artifact tree
#   set -a; source paths.env; set +a
#   bash perf_per_target_run.sh

# Path to your revmc checkout (the directory containing target/, examples/, ...).
# The default tries to auto-discover from the script location.
REVMC_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")/../../.." && pwd)"

# Block dataset: a directory containing states/<block>.bin and txs/<block>.bin
# files for the blocks the bench will replay. The bench enters here via
# --bench-dir.
BLOCK_DATA=/path/to/block_data

# Per-bytecode .so cache. Each contract is compiled into its own .so named
# <code_hash>__prague__o3.so plus the matching .o. Produced by an earlier
# compile pass (see examples/runner/src/bin/skelot_compile_bench.rs).
PERHASH_CACHE=/path/to/per_hash_cache

# Per-skeleton (family) .so cache. Each family has skel_<short>__prague__o3.so
# plus matching .o; per-bytecode <code_hash>__prague__o3.so files for the
# family's representative members live here too. Produced by the same
# compile pass.
SKELOT_CACHE=/path/to/skelot_cache

# Pre-built skeleton registry binary. Generated automatically the first time
# skeleton_vs_perhash_bench runs without --registry; subsequent runs pass
# --registry "$SKELOT_REGISTRY" to skip the (~5 min) family-scan phase.
SKELOT_REGISTRY=/path/to/skeleton_registry_full.bin

# Read-only paper input directory. Contains skeleton_vs_perhash.json,
# compile_bench.json, dataset_scan.json, skeleton_families.json,
# ablation_allvariant.families.jsonl, and skeleton_mapping.tsv. The Python
# analysis scripts read from here.
INPUT_DATA_DIR=/path/to/input_data

# Output directory for everything the scripts produce (CSVs, JSONs, PNGs,
# perf .stat files, bench .log files). Defaults to `output/` next to the
# script. Override here if you want artifacts written elsewhere.
# OUT_DIR="$REVMC_ROOT/examples/runner/scripts/runtime_attribution/output"
